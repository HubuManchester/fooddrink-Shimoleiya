<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DailyFoodSetApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DailyFoodSetApp.Views"
    Title="Daily Meal Planner"
    Shell.BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}"
    Shell.ForegroundColor="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}"
    Shell.TitleColor="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
    Shell.TabBarTitleColor="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#A0D6B4, Dark=#555555}">

    <TabBar>
        <ShellContent Title="Generator" ContentTemplate="{DataTemplate views:MealGeneratorPage}" />
        <ShellContent Title="Catalog" ContentTemplate="{DataTemplate views:FoodSearchPage}" />
        <ShellContent Title="Daily Share" ContentTemplate="{DataTemplate views:HardwarePage}" />
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>
</Shell>