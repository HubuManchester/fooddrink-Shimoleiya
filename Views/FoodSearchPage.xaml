<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyFoodSetApp.Views.FoodSearchPage"
             BackgroundColor="#F5FFF5"
             Title="Food Search">
    <Grid RowDefinitions="Auto, Auto, *">

        <Border Stroke="#2E8B57" StrokeThickness="2" BackgroundColor="White" Padding="0" Margin="15,15,15,5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <SearchBar x:Name="FoodSearchBar" 
                       Placeholder="Search food name..." 
                       SearchButtonPressed="OnSearchPressed"
                       CancelButtonColor="#2E8B57"
                       SemanticProperties.Hint="Type a name and press search" />
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="15,5,15,10">
            <Border Grid.Column="0" Stroke="#A0D6B4" StrokeThickness="1" BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Picker x:Name="CategoryPicker" Title="Category" FontSize="13" TextColor="#333333" SelectedIndexChanged="OnFilterChanged">
                    <Picker.Items>
                        <x:String>All</x:String>
                        <x:String>Breakfast</x:String>
                        <x:String>Lunch</x:String>
                        <x:String>Dinner</x:String>
                        <x:String>Drink</x:String>
                    </Picker.Items>
                </Picker>
            </Border>

            <Border Grid.Column="1" Stroke="#A0D6B4" StrokeThickness="1" BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Picker x:Name="SpicinessPicker" Title="Spiciness" FontSize="13" TextColor="#333333" SelectedIndexChanged="OnFilterChanged">
                    <Picker.Items>
                        <x:String>All</x:String>
                        <x:String>Not Spicy</x:String>
                        <x:String>Mild</x:String>
                        <x:String>Medium</x:String>
                        <x:String>Extra Spicy</x:String>
                    </Picker.Items>
                </Picker>
            </Border>

            <Border Grid.Column="2" Stroke="#A0D6B4" StrokeThickness="1" BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Picker x:Name="CaloriesPicker" Title="Calories" FontSize="13" TextColor="#333333" SelectedIndexChanged="OnFilterChanged">
                    <Picker.Items>
                        <x:String>All</x:String>
                        <x:String>0 - 300</x:String>
                        <x:String>301 - 600</x:String>
                        <x:String>600+</x:String>
                    </Picker.Items>
                </Picker>
            </Border>
        </Grid>

        <RefreshView Grid.Row="2" x:Name="FoodRefreshView" Refreshing="OnRefreshing" RefreshColor="#2E8B57">
            <CollectionView x:Name="FoodCollection" 
                            Margin="15,0,15,0"
                            SelectionMode="None"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReached="OnLoadMore">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,50,0,0">
                        <Label Text="🍽️" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="没有查询到匹配的菜品" FontSize="18" TextColor="#666666" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Try adjusting your filters or search term." FontSize="14" TextColor="#999999" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#A0D6B4" StrokeThickness="1" BackgroundColor="White" Padding="15" Margin="0,0,0,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#333333" SemanticProperties.HeadingLevel="Level2"/>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Category}" TextColor="#2E8B57" FontAttributes="Bold"/>
                                    <Label Text="{Binding Spiciness}" TextColor="#FF4500"/>
                                    <Label Text="{Binding CaloriesLabel}" TextColor="#FF8C00" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Description}" FontSize="12" TextColor="#666666"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>