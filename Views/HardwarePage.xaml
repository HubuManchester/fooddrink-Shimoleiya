<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyFoodSetApp.Views.HardwarePage"
             BackgroundColor="{AppThemeBinding Light=#F5FFF5, Dark=#121212}"
             Title="Daily Share">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <Border Stroke="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}" 
                    StrokeThickness="2" 
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Label Text="Create a Post" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}"/>

                    <Entry x:Name="CaloriesEntry" 
                           Placeholder="Calories (e.g., 450)" 
                           Keyboard="Numeric" 
                           TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Flashlight" BackgroundColor="#F29B38" TextColor="White" FontAttributes="Bold" Clicked="OnFlashlightClicked"/>
                        <Button Grid.Column="1" Text="Take Photo" BackgroundColor="#2E8B57" TextColor="White" FontAttributes="Bold" Clicked="OnTakePhotoClicked"/>
                    </Grid>

                    <Button Text="Get Location" BackgroundColor="#2E8B57" TextColor="White" FontAttributes="Bold" Clicked="OnLocateClicked"/>

                    <Label x:Name="StatusLabel" Text="Ready to share." FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" HorizontalOptions="Center"/>

                    <Button Text="Share Now" BackgroundColor="#FF8C00" TextColor="White" FontAttributes="Bold" Clicked="OnShareClicked"/>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="PostCard" IsVisible="False" Stroke="{AppThemeBinding Light=#A0D6B4, Dark=#2E8B57}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto, *">
                        <Image Source="dotnet_bot.png" WidthRequest="40" HeightRequest="40" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="My Daily Diet" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label x:Name="PostTimeLabel" FontSize="12" TextColor="{AppThemeBinding Light=#999999, Dark=#777777}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Border StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Image x:Name="PostImage" Aspect="AspectFill" HeightRequest="200" BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#121212}"/>
                    </Border>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🔥" FontSize="16"/>
                        <Label x:Name="PostCaloriesLabel" FontSize="16" FontAttributes="Bold" TextColor="#FF8C00"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="📍" FontSize="16"/>
                        <Label x:Name="PostLocationLabel" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>