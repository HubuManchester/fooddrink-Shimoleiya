<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyFoodSetApp.Views.HardwarePage"
             Title="Share">

    <CollectionView x:Name="FeedCollectionView" ItemsSource="{Binding FeedPosts}">

        <CollectionView.Header>
            <VerticalStackLayout Padding="20" Spacing="18">

                <Label Text="Snap a Photo" FontSize="18" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="Take a Photo" Clicked="OnTakePhotoClicked" BackgroundColor="#512BD4" TextColor="White" />
                    <Button Grid.Column="1" x:Name="FlashlightButton" Text="Turn On Flashlight" Clicked="OnToggleFlashlightClicked" BackgroundColor="#512BD4" TextColor="White" />
                </Grid>
                <Image x:Name="FoodPhoto" HeightRequest="200" BackgroundColor="#EFEFEF" Aspect="AspectFit" />

                <BoxView HeightRequest="1" Color="LightGray" />

                <Label Text="Where are you?" FontSize="18" FontAttributes="Bold" />
                <Button Text="Add Location" Clicked="OnGetLocationClicked" BackgroundColor="#512BD4" TextColor="White" />
                <Label x:Name="CoordinateLabel" Text="Location not added yet" FontSize="14" />
                <Label x:Name="LocationLabel" Text="Tap the button above to add your location." FontSize="14" />

                <BoxView HeightRequest="1" Color="LightGray" />

                <Label Text="Tell us about it" FontSize="18" FontAttributes="Bold" />
                <Editor x:Name="PostDescriptionEditor" Placeholder="What's on your mind?" HeightRequest="100" />
                <Button Text="Share Post" Clicked="OnShareClicked" BackgroundColor="Green" TextColor="White" />

                <BoxView HeightRequest="2" Color="Black" Margin="0,15,0,5" />
                <Label Text="Recent Posts" FontSize="20" FontAttributes="Bold" Margin="0,0,0,10" />

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <ContentView Padding="20,0,20,15">
                    <Border StrokeThickness="1" Stroke="LightGray" Padding="15" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Image Source="{Binding ImagePath}" HeightRequest="200" Aspect="AspectFill" IsVisible="{Binding HasImage}" />

                            <Label Text="{Binding Description}" FontSize="16" />
                            <Label Text="{Binding LocationInfo}" FontSize="12" TextColor="Gray" IsVisible="{Binding HasLocation}" />

                            <Button Text="Remove Post" 
                                    BackgroundColor="Red" 
                                    TextColor="White" 
                                    HeightRequest="40"
                                    Margin="0,10,0,0"
                                    CommandParameter="{Binding Id}" 
                                    Clicked="OnDeletePostClicked" />
                        </VerticalStackLayout>
                    </Border>
                </ContentView>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>