<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyFoodSetApp.Views.FoodDetailPage"
             BackgroundColor="{AppThemeBinding Light=#F5FFF5, Dark=#121212}"
             Title="Food Details">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            <Border Stroke="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}"
                    StrokeThickness="2"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Label x:Name="NameLabel" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" 
                           SemanticProperties.HeadingLevel="Level1"/>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#A0D6B4, Dark=#2E8B57}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <Label Text="Category:" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Label x:Name="CategoryLabel" Grid.Column="1" TextColor="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}" FontAttributes="Bold"/>

                        <Label Grid.Row="1" Text="Calories:" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Label x:Name="CaloriesLabel" Grid.Row="1" Grid.Column="1" TextColor="#FF8C00" FontAttributes="Bold"/>

                        <Label Grid.Row="2" Text="Spiciness:" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Label x:Name="SpicinessLabel" Grid.Row="2" Grid.Column="1" TextColor="#FF4500" FontAttributes="Bold"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#A0D6B4, Dark=#2E8B57}" />

                    <Label Text="Description" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                    <Label x:Name="DescriptionLabel" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Button Text="Read Aloud"
                        BackgroundColor="#2E8B57"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="OnReadClicked"/>

                <Button Grid.Column="1"
                        Text="Stop Reading"
                        BackgroundColor="Transparent"
                        BorderColor="#2E8B57"
                        BorderWidth="2"
                        TextColor="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}"
                        FontAttributes="Bold"
                        Clicked="OnStopReadClicked"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>