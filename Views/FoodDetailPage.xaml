<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyFoodSetApp.Views.FoodDetailPage"
             Title="Food Details">

    <ScrollView>
        <ScrollView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#FFF1DA, Dark=#130F0C}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#FFF9EF, Dark=#0F1711}" Offset="1.0" />
            </LinearGradientBrush>
        </ScrollView.Background>

        <VerticalStackLayout Padding="24" Spacing="16">
            <Border StrokeThickness="0" Padding="18" BackgroundColor="{AppThemeBinding Light=#FFFDF8, Dark=#1A1712}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Label x:Name="NameDisplay" FontSize="26" FontAttributes="Bold" />
                    <Label x:Name="CategoryDisplay" Grid.Row="1" FontSize="16" TextColor="Gray" />
                    <Label x:Name="CaloriesDisplay" Grid.Row="2" FontSize="20" FontAttributes="Bold" TextColor="#A95517" />
                </Grid>
            </Border>

            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}" BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Flavor Profile" FontSize="16" FontAttributes="Bold" TextColor="#512BD4" />
                    <Label x:Name="SpecsDisplay" FontSize="15" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}" />
                    <Label Text="About this food" FontSize="14" FontAttributes="Bold" TextColor="#512BD4" />
                    <Label x:Name="DescriptionDisplay" FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Read Aloud" Clicked="OnNarrateSummaryClicked" BackgroundColor="Green" TextColor="White" HeightRequest="48" />
                <Button Grid.Column="1" Text="Stop Reading" Clicked="OnStopNarratingClicked" BackgroundColor="Orange" TextColor="White" HeightRequest="48" />
            </Grid>

            <Button Text="Delete Food" 
                    Clicked="OnTerminateRecordClicked" 
                    BackgroundColor="Red" 
                    TextColor="White" 
                    HeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>