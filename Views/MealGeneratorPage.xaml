<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DailyFoodSetApp.Views.MealGeneratorPage"
             BackgroundColor="{AppThemeBinding Light=#F5FFF5, Dark=#121212}"
             Title="Meal Planner">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <Border Stroke="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}" 
                    StrokeThickness="2" 
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Plan your meals for today" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}"/>

                    <Entry x:Name="CaloriesEntry" Placeholder="How many calories do you want today?" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Picker x:Name="SpicinessPicker" Title="Spiciness Level" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}">
                            <Picker.Items>
                                <x:String>Not Spicy</x:String>
                                <x:String>Mild</x:String>
                                <x:String>Medium</x:String>
                                <x:String>Extra Spicy</x:String>
                            </Picker.Items>
                        </Picker>

                        <Picker Grid.Column="1" x:Name="SweetnessPicker" Title="Drink Sweetness" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}">
                            <Picker.Items>
                                <x:String>Sugar Free</x:String>
                                <x:String>Medium Sweet</x:String>
                                <x:String>Full Sugar</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>

                    <Button Text="Create My Meal Plan" BackgroundColor="#2E8B57" TextColor="White" FontAttributes="Bold" Clicked="OnGenerateClicked"/>

                    <Button Text="Shake for a Surprise Meal!" BackgroundColor="#FF8C00" TextColor="White" FontAttributes="Bold" Margin="0,10,0,0" Clicked="OnShakeButtonClicked" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="ResultsContainer" IsVisible="False" Spacing="15">
                <Label Text="Here are our tasty suggestions for you" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}"/>
                <CollectionView x:Name="MealPlanCollection">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="{AppThemeBinding Light=#A0D6B4, Dark=#2E8B57}" 
                                    StrokeThickness="1" 
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                                    Padding="15" Margin="0,0,0,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                    <Label Text="{Binding Category}" FontSize="14" TextColor="{AppThemeBinding Light=#2E8B57, Dark=#A0D6B4}" FontAttributes="Bold"/>
                                    <Label Grid.Row="1" Text="{Binding Name}" FontSize="18" TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}" FontAttributes="Bold"/>
                                    <HorizontalStackLayout Grid.Row="2" Spacing="10" Margin="0,5,0,0">
                                        <Label Text="{Binding Spiciness}" FontSize="12" TextColor="#FF4500"/>
                                        <Label Text="{Binding Sweetness}" FontSize="12" TextColor="#D02090"/>
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="1" Grid.RowSpan="3" Text="{Binding CaloriesLabel}" FontSize="16" TextColor="#FF8C00" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>